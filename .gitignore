# ==============================================================================
# TicketFlow Root .gitignore
# ==============================================================================

# Node.js / Frontend Dependencies & Cache
node_modules/
**/node_modules/
.npm
.vite/
**/.vite/
.angular/
**/.angular/

# Build Outputs
dist/
**/dist/
build/
**/build/
out/
.next/

# PHP / Composer
vendor/
**/vendor/
composer.phar
.phpunit.result.cache

# Laravel Runtime Storage & Sessions (preserve directory structures via .gitignore)
ticketflow-backend/storage/*.key
ticketflow-backend/storage/framework/cache/data/*
ticketflow-backend/storage/framework/sessions/*
ticketflow-backend/storage/framework/views/*
ticketflow-backend/storage/logs/*
ticketflow-backend/bootstrap/cache/*
!ticketflow-backend/storage/**/.gitignore
!ticketflow-backend/bootstrap/cache/.gitignore

# Environment & Secrets (NEVER push production credentials)
.env
.env.*
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS & Editor generated files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?