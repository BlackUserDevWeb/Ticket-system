APP_NAME=TicketFlow
APP_ENV=production
APP_KEY=base64:EXAMPLEKEYCHANGEINPRODUCTION=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lome
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticketflow
DB_USERNAME=ticketflow_user
DB_PASSWORD=secret

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=ticketflow_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:4300

REVERB_APP_ID=ticketflow
REVERB_APP_KEY=ticketflow-reverb-key
REVERB_APP_SECRET=ticketflow-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Configuration Métier TicketFlow Togo
TICKETFLOW_SERVICE_RATE=0.035
TICKETFLOW_HOLD_DURATION_MINUTES=5

# Passerelles Mobile Money (Togo)
MOOV_MONEY_BASE_URL=https://api.moov-africa.tg/v1
MOOV_MONEY_CLIENT_ID=
MOOV_MONEY_SECRET=
MOOV_MONEY_WEBHOOK_SECRET=

MIXX_YAS_BASE_URL=https://api.mixxbyyas.tg/v1
MIXX_YAS_CLIENT_ID=
MIXX_YAS_SECRET=
MIXX_YAS_WEBHOOK_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@ticketflow.tg"
MAIL_FROM_NAME="${APP_NAME}"
